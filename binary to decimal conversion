// binary to decimal conversion ...
#include<iostream>
using namespace std;
int main()
{
    string s = "1010001010101010110101";

    int sm = 0;
    int pof2 = 1;
    for(int i=s.length()-1;i>=0;i--)
    {
        if(s[i]=='1')
        {
            sm+=pof2;
        }
        pof2*=2;
    }
    cout<<sm;
    return 0;
}
